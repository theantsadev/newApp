# =============================================================================
# ETAPE 6 - MISE A JOUR DATE DE DISPONIBILITE ET PRIX D'ACHAT
# =============================================================================
# PATCH permet de ne mettre à jour que les champs spécifiés.
# wholesale_price = prix d'achat HT (utilisé pour calculer la marge).
# available_date  = date à partir de laquelle le produit est disponible.

#### 6.1 - T_01 : dispo 01/12/2025, achat 7,61€ HT
PATCH {{webservice_url}}/api/products/{{id_product_T01}}
Authorization: Basic {{webservice_basic_auth}}
Content-Type: application/xml

<?xml version="1.0" encoding="UTF-8"?>
<prestashop xmlns:xlink="http://www.w3.org/1999/xlink">
  <product>
    <id><![CDATA[{{id_product_T01}}]]></id>
    <available_date><![CDATA[2025-12-01]]></available_date>
    <wholesale_price><![CDATA[7.61]]></wholesale_price>
  </product>
</prestashop>

###

