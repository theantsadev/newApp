# =============================================================================
# CONFIGURATION
# =============================================================================

@webservice_url = http://localhost:70/prestashop
@webservice_basic_auth = SFRXV1pBUUdTOTFMUUsyTkE2N0RCUzRMWjVFR1JORks6




# =============================================================================
# DONNEES DE REFERENCE
# =============================================================================
# Produits à créer :
# date_dispo  | nom      | référence | prix_TTC | TVA    | catégorie   | prix_achat
# 01/12/2025  | Tshirt   | T_01      | 12,50 €  | 11,65% | Akanjo      | 8,50 €
# 02/05/2026  | Pantalon | P_01      | 18,99 €  | 11,65% | Akanjo      | 14,33 €
# 08/05/2026  | Casquette| C_03      | 5,00 €   | 5,60%  | Accessoire  | 2,00 €
# 08/05/2026  | Montre   | M_02      | 56,00 €  | 5,60%  | Accessoire  | 40,00 €
#
# Calcul prix HT depuis prix TTC :
#   T_01  : 12,50 / 1,1165 = 11,20 HT  | wholesale_price HT : 8,50 / 1,1165 = 7,61
#   P_01  : 18,99 / 1,1165 = 17,01 HT  | wholesale_price HT : 14,33 / 1,1165 = 12,83
#   C_03  : 5,00 / 1,056   = 4,73 HT   | wholesale_price HT : 2,00 / 1,056  = 1,89
#   M_02  : 56,00 / 1,056  = 53,03 HT  | wholesale_price HT : 40,00 / 1,056 = 37,88
# =============================================================================




# =============================================================================
# ETAPE 1 - CREATION DES TAXES
# =============================================================================
# Deux taux de TVA utilisés :
#   - TRG1 : 11,65% → pour les vêtements (Akanjo)
#   - TRG2 : 5,60%  → pour les accessoires

#### 1.1 - Taxe 11,65% (vêtements)
POST {{webservice_url}}/api/taxes
Authorization: Basic {{webservice_basic_auth}}
Content-Type: application/xml

<?xml version="1.0" encoding="UTF-8"?>
<prestashop xmlns:xlink="http://www.w3.org/1999/xlink">
  <tax>
    <rate><![CDATA[11.650]]></rate>
    <active><![CDATA[1]]></active>
    <name>
      <language id="1"><![CDATA[TVA FR 11.65%]]></language>
    </name>
  </tax>
</prestashop>
### => id_tax_1 = 33

@id_tax_1 = 33

###

#### 1.2 - Taxe 5,60% (accessoires)
POST {{webservice_url}}/api/taxes
Authorization: Basic {{webservice_basic_auth}}
Content-Type: application/xml

<?xml version="1.0" encoding="UTF-8"?>
<prestashop xmlns:xlink="http://www.w3.org/1999/xlink">
  <tax>
    <rate><![CDATA[5.600]]></rate>
    <active><![CDATA[1]]></active>
    <name>
      <language id="1"><![CDATA[TVA FR 5.6%]]></language>
    </name>
  </tax>
</prestashop>
### => id_tax_2 = 34

@id_tax_2 = 34

###




# =============================================================================
# ETAPE 2 - CREATION DES GROUPES DE REGLES DE TAXES (Tax Rule Groups)
# =============================================================================
# Un Tax Rule Group regroupe les règles de taxe par pays.
# Il est ensuite associé à un produit via id_tax_rules_group.

#### 2.1 - Tax Rule Group pour TVA 11,65% (TRG1)
POST {{webservice_url}}/api/tax_rule_groups
Authorization: Basic {{webservice_basic_auth}}
Content-Type: application/xml

<?xml version="1.0" encoding="UTF-8"?>
<prestashop xmlns:xlink="http://www.w3.org/1999/xlink">
  <tax_rule_group>
    <name><![CDATA[TRG1]]></name>
    <active><![CDATA[1]]></active>
  </tax_rule_group>
</prestashop>
### => id_trg_1 = 7

@id_trg_1 = 7

###

#### 2.2 - Tax Rule Group pour TVA 5,60% (TRG2)
POST {{webservice_url}}/api/tax_rule_groups
Authorization: Basic {{webservice_basic_auth}}
Content-Type: application/xml

<?xml version="1.0" encoding="UTF-8"?>
<prestashop xmlns:xlink="http://www.w3.org/1999/xlink">
  <tax_rule_group>
    <name><![CDATA[TRG2]]></name>
    <active><![CDATA[1]]></active>
  </tax_rule_group>
</prestashop>
### => id_trg_2 = 8

@id_trg_2 = 8

###




# =============================================================================
# ETAPE 3 - CREATION DES REGLES DE TAXES (Tax Rules)
# =============================================================================
# Une Tax Rule lie un Tax Rule Group à une taxe pour un pays donné.
# id_country = 8 = France

#### 3.1 - Règle TVA 11,65% → France (pour TRG1)
POST {{webservice_url}}/api/tax_rules
Authorization: Basic {{webservice_basic_auth}}
Content-Type: application/xml

<?xml version="1.0" encoding="UTF-8"?>
<prestashop xmlns:xlink="http://www.w3.org/1999/xlink">
  <tax_rule>
    <id_tax_rules_group><![CDATA[{{id_trg_1}}]]></id_tax_rules_group>
    <id_tax><![CDATA[{{id_tax_1}}]]></id_tax>
    <id_country><![CDATA[8]]></id_country>
  </tax_rule>
</prestashop>
### => 146

###

#### 3.2 - Règle TVA 5,60% → France (pour TRG2)
POST {{webservice_url}}/api/tax_rules
Authorization: Basic {{webservice_basic_auth}}
Content-Type: application/xml

<?xml version="1.0" encoding="UTF-8"?>
<prestashop xmlns:xlink="http://www.w3.org/1999/xlink">
  <tax_rule>
    <id_tax_rules_group><![CDATA[{{id_trg_2}}]]></id_tax_rules_group>
    <id_tax><![CDATA[{{id_tax_2}}]]></id_tax>
    <id_country><![CDATA[8]]></id_country>
  </tax_rule>
</prestashop>
### => 148

###




# =============================================================================
# ETAPE 4 - CREATION DES CATEGORIES
# =============================================================================
# id_parent = 2 = Accueil (racine du catalogue)

#### 4.1 - Catégorie Akanjo (vêtements)
POST {{webservice_url}}/api/categories
Authorization: Basic {{webservice_basic_auth}}
Content-Type: application/xml

<?xml version="1.0" encoding="UTF-8"?>
<prestashop xmlns:xlink="http://www.w3.org/1999/xlink">
  <category>
    <active><![CDATA[1]]></active>
    <id_parent><![CDATA[]]></id_parent>
    <name>
      <language id="1"><![CDATA[Akanjo]]></language>
    </name>
    <link_rewrite>
      <language id="1"><![CDATA[akanjo]]></language>
    </link_rewrite>
    <description>
      <language id="1"><![CDATA[akanjo]]></language>
    </description>
  </category>
</prestashop>
### => id_category_akanjo = 10

@id_category_akanjo = 10

###

#### 4.2 - Catégorie Accessoire
PUT {{webservice_url}}/api/categories
Authorization: Basic {{webservice_basic_auth}}
Content-Type: application/xml

<?xml version="1.0" encoding="UTF-8"?>
<prestashop xmlns:xlink="http://www.w3.org/1999/xlink">
  <category>
    <active><![CDATA[1]]></active>
    <id_parent><![CDATA[2]]></id_parent>
    <name>
      <language id="1"><![CDATA[Accessoire]]></language>
    </name>
    <link_rewrite>
      <language id="1"><![CDATA[accessoire]]></language>
    </link_rewrite>
    <description>
      <language id="1"><![CDATA[accessoire]]></language>
    </description>
  </category>
</prestashop>
### => id_category_accessoire = 11

@id_category_accessoire = 11

###




# =============================================================================
# ETAPE 5 - CREATION DES PRODUITS
# =============================================================================
# Notes :
#   - price = prix HT (PrestaShop stocke toujours le HT)
#   - wholesale_price = prix d'achat HT (mis à jour en étape 6)
#   - id_tax_rules_group lie le produit à son groupe de taxe
#   - product_type = "combinations" pour T_01 (déclinaisons de taille)
#   - product_type = "standard" pour les autres

#### 5.1 - Produit T_01 : Tshirt (avec déclinaisons)
POST {{webservice_url}}/api/products
Authorization: Basic {{webservice_basic_auth}}
Content-Type: application/xml

<?xml version="1.0" encoding="UTF-8"?>
<prestashop xmlns:xlink="http://www.w3.org/1999/xlink">
  <product>
    <id_category_default><![CDATA[{{id_category_akanjo}}]]></id_category_default>
    <id_tax_rules_group><![CDATA[{{id_trg_1}}]]></id_tax_rules_group>
    <id_shop_default><![CDATA[1]]></id_shop_default>
    <reference><![CDATA[T_01]]></reference>
    <price><![CDATA[11.20]]></price>
    <active><![CDATA[1]]></active>
    <available_for_order><![CDATA[1]]></available_for_order>
    <show_price><![CDATA[1]]></show_price>
    <state><![CDATA[1]]></state>
    <minimal_quantity><![CDATA[1]]></minimal_quantity>
    <product_type><![CDATA[combinations]]></product_type>
    <ecotax><![CDATA[0]]></ecotax>
    <on_sale><![CDATA[0]]></on_sale>
    <online_only><![CDATA[0]]></online_only>
    <cache_is_pack><![CDATA[0]]></cache_is_pack>
    <name>
      <language id="1"><![CDATA[Tshirt]]></language>
    </name>
    <description>
      <language id="1"><![CDATA[Tshirt]]></language>
    </description>
    <description_short>
      <language id="1"><![CDATA[Tshirt]]></language>
    </description_short>
    <link_rewrite>
      <language id="1"><![CDATA[tshirt]]></language>
    </link_rewrite>
    <meta_description>
      <language id="1"><![CDATA[]]></language>
    </meta_description>
    <associations>
      <categories>
        <category><id><![CDATA[{{id_category_akanjo}}]]></id></category>
      </categories>
    </associations>
  </product>
</prestashop>
### => id_product_T01 = 20

@id_product_T01 = 20

###

