# =============================================================================
# RECAP DES IDS
# =============================================================================
# Taxes         : TVA 11,65% = 33 | TVA 5,60% = 34
# Tax Grp       : TRG1 (11,65%) = 7 | TRG2 (5,60%) = 8
# Catégories    : Akanjo = 10 | Accessoire = 11
# Produits      : T_01 = 20 | P_01 = 21 | C_03 = 22 | M_02 = 23
# =============================================================================
