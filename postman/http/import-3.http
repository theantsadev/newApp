#### 5.4 - Enregistrement du paiement commande 2
# order_reference = référence alphanumérique générée par PrestaShop (pas l'id).
# Récupérer la référence dans la réponse du POST /api/orders (champ <reference>).
POST {{webservice_url}}/api/order_payments
Authorization: Basic {{webservice_basic_auth}}
Content-Type: application/xml

<?xml version="1.0" encoding="UTF-8"?>
<prestashop xmlns:xlink="http://www.w3.org/1999/xlink">
  <order_payment>
    <order_reference><![CDATA[REFERENCE_COMMANDE_2]]></order_reference>
    <id_currency><![CDATA[1]]></id_currency>
    <amount><![CDATA[34.98]]></amount>
    <payment_method><![CDATA[Paiement par chèque]]></payment_method>
    <conversion_rate><![CDATA[1.000000]]></conversion_rate>
    <date_add><![CDATA[2026-04-16 00:00:00]]></date_add>
  </order_payment>
</prestashop>

