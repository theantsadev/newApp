# =============================================================================
# CONFIGURATION
# =============================================================================

@webservice_url = http://localhost:70/prestashop
@webservice_basic_auth = SFRXV1pBUUdTOTFMUUsyTkE2N0RCUzRMWjVFR1JORms6




# =============================================================================
# SCENARIO - CREATION DE 3 COMMANDES
# =============================================================================
# date        | client | adresse         | articles              | état
# 09/05/2026  | Rakoto | Andoharanofotsy | T_01 ngoza x3         | En attente paiement à la livraison (state=13)
# 16/04/2026  | Rajao  | Analakely       | T_01 kely x2 + C_03x1 | Paiement accepté (state=2)
# 07/05/2026  | Rakoto | Andoharanofotsy | T_01 kely x1          | Erreur de paiement (state=8)
#
# Calcul des montants :
#   T_01 ngoza : 11,20 HT × 3 = 33,60 HT → 12,50 TTC × 3 = 37,50 TTC
#   T_01 kely  : 13,43 HT     → 14,99 TTC  (prix_base 11,20 + supplément 2,23)
#   C_03       : 4,73 HT      → 5,00 TTC
#
# Mapping module ↔ état (IMPORTANT - incohérence = erreur de paiement) :
#   ps_cashondelivery → state 13 "En attente de paiement à la livraison"
#   ps_checkpayment   → state 1  "En attente du paiement par chèque"
#   (vide)            → state 2  "Paiement accepté"
#   (vide)            → state 8  "Erreur de paiement"
# =============================================================================




