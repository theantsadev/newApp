# =============================================================================
# COMMANDE 1 - Rakoto | T_01 ngoza x3 | En attente paiement à la livraison
# =============================================================================
# module        : ps_cashondelivery → state 13 obligatoire (sinon erreur de paiement)
# payment       : libellé affiché dans le back-office
# delivery_option : {"id_address":"id_carrier,"} — requis pour que PrestaShop
#                   valide le transporteur et évite l'erreur de paiement
# total_paid_real = 0 car pas encore encaissé
# valid         = 0 car commande non validée

#### 4.1 - Panier commande 1
POST {{webservice_url}}/api/carts
Authorization: Basic {{webservice_basic_auth}}
Content-Type: application/xml

<?xml version="1.0" encoding="UTF-8"?>
<prestashop xmlns:xlink="http://www.w3.org/1999/xlink">
  <cart>
    <id_address_delivery><![CDATA[{{id_address_rakoto}}]]></id_address_delivery>
    <id_address_invoice><![CDATA[{{id_address_rakoto}}]]></id_address_invoice>
    <id_currency><![CDATA[1]]></id_currency>
    <id_customer><![CDATA[{{id_customer_rakoto}}]]></id_customer>
    <id_lang><![CDATA[1]]></id_lang>
    <id_shop><![CDATA[1]]></id_shop>
    <id_shop_group><![CDATA[1]]></id_shop_group>
    <id_carrier><![CDATA[1]]></id_carrier>
    <delivery_option><![CDATA[{"{{id_address_rakoto}}":"1,"}]]></delivery_option>
    <recyclable><![CDATA[0]]></recyclable>
    <gift><![CDATA[0]]></gift>
    <associations>
      <cart_rows>
        <cart_row>
          <id_product><![CDATA[{{id_product_T01}}]]></id_product>
          <id_product_attribute><![CDATA[{{id_comb_ngoza}}]]></id_product_attribute>
          <id_address_delivery><![CDATA[{{id_address_rakoto}}]]></id_address_delivery>
          <id_customization><![CDATA[0]]></id_customization>
          <quantity><![CDATA[3]]></quantity>
        </cart_row>
      </cart_rows>
    </associations>
  </cart>
</prestashop>
