Content-Type: application/xml

<?xml version="1.0" encoding="UTF-8"?>
<prestashop xmlns:xlink="http://www.w3.org/1999/xlink">
  <product_option_value>
    <id_attribute_group><![CDATA[{{id_option_couleur}}]]></id_attribute_group>
    <color><![CDATA[#FFFFFF]]></color>
    <name>
      <language id="1"><![CDATA[fotsy]]></language>
    </name>
  </product_option_value>
</prestashop>
### => id_val_fotsy = 28

@id_val_fotsy = 28

###

#### 3.4 - Valeur couleur : mainty (noir #000000)
POST {{webservice_url}}/api/product_option_values
Authorization: Basic {{webservice_basic_auth}}
Content-Type: application/xml

<?xml version="1.0" encoding="UTF-8"?>
<prestashop xmlns:xlink="http://www.w3.org/1999/xlink">
  <product_option_value>
    <id_attribute_group><![CDATA[{{id_option_couleur}}]]></id_attribute_group>
