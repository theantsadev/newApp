    <minimal_quantity><![CDATA[1]]></minimal_quantity>
    <default_on><![CDATA[0]]></default_on>
    <associations>
      <product_option_values>
        <product_option_value><id><![CDATA[{{id_val_kely}}]]></id></product_option_value>
      </product_option_values>
    </associations>
  </combination>
</prestashop>
### => id_comb_kely = 41

@id_comb_kely = 41

