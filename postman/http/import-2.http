# =============================================================================
# RECAP DES IDS
# =============================================================================
# Options         : taille = 5 | couleur = 6
# Valeurs         : ngoza = 26 | kely = 27 | fotsy = 28 | mainty = 29
# Combinations    : T_01-ngoza = 40 | T_01-kely = 41 | P_01-fotsy = 42 | P_01-mainty = 43
# Stocks          : ngoza = 63 | kely = 64 | fotsy = 65 | mainty = 66 | C_03 = 61 | M_02 = 62
# =============================================================================
