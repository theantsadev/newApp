# =============================================================================
# CONFIGURATION
# =============================================================================

@webservice_url = http://localhost:70/prestashop
@webservice_basic_auth = SFRXV1pBUUdTOTFMUUsyTkE2N0RCUzRMWjVFR1JORks6




# =============================================================================
# DONNEES DE REFERENCE
# =============================================================================
# référence | spécificité | déclinaison | stock | prix_TTC
# T_01      | taille      | ngoza       | 13    | 12,50 €  (prix de base)
# T_01      | taille      | kely        | 10    | 15,00 €  (supplément +2,23 HT)
# P_01      | couleur     | mainty      | 5     | 23,49 €  (supplément +4,03 HT)
# P_01      | couleur     | fotsy       | 3     | 18,99 €  (prix de base)
# C_03      | —           | —           | 10    | 5,00 €   (sans déclinaison)
# M_02      | —           | —           | 11    | 56,00 €  (sans déclinaison)
#
# Calcul des suppléments HT :
#   T_01 kely   : 15,00 / 1,1165 - 11,20 = 13,43 - 11,20 = +2,23 HT
#   P_01 mainty : 23,49 / 1,1165 - 17,01 = 21,04 - 17,01 = +4,03 HT
# =============================================================================




# =============================================================================
# ETAPE 1 - RECUPERATION DES IDS PRODUITS
# =============================================================================
# On filtre par référence pour récupérer l'id interne de chaque produit.

#### 1.1 - Id produit T_01
GET {{webservice_url}}/api/products?filter[reference]=[T_01]&display=[id]
Authorization: Basic {{webservice_basic_auth}}
### => id_product_T01 = 20

@id_product_T01 = 20

###

#### 1.2 - Id produit P_01
GET {{webservice_url}}/api/products?filter[reference]=[P_01]&display=[id]
Authorization: Basic {{webservice_basic_auth}}
### => id_product_P01 = 21

@id_product_P01 = 21

###

#### 1.3 - Id produit C_03
GET {{webservice_url}}/api/products?filter[reference]=[C_03]&display=[id]
Authorization: Basic {{webservice_basic_auth}}
### => id_product_C03 = 22

@id_product_C03 = 22

###

#### 1.4 - Id produit M_02
GET {{webservice_url}}/api/products?filter[reference]=[M_02]&display=[id]
Authorization: Basic {{webservice_basic_auth}}
### => id_product_M02 = 23

@id_product_M02 = 23

###




# =============================================================================
# ETAPE 2 - CREATION DES OPTIONS (attributs de déclinaison)
# =============================================================================
# Un product_option = un groupe d'attributs (ex: "taille", "couleur").
# group_type valeurs acceptées : "select", "radio", "color"
# is_color_group = 1 uniquement pour le type "color".

#### 2.1 - Option "taille" (liste déroulante)
POST {{webservice_url}}/api/product_options
Authorization: Basic {{webservice_basic_auth}}
Content-Type: application/xml

<?xml version="1.0" encoding="UTF-8"?>
<prestashop xmlns:xlink="http://www.w3.org/1999/xlink">
  <product_option>
    <is_color_group><![CDATA[0]]></is_color_group>
    <group_type><![CDATA[select]]></group_type>
    <name>
      <language id="1"><![CDATA[taille]]></language>
    </name>
    <public_name>
      <language id="1"><![CDATA[taille]]></language>
    </public_name>
  </product_option>
</prestashop>
### => id_option_taille = 5

@id_option_taille = 5

###

#### 2.2 - Option "couleur" (sélecteur de couleur)
POST {{webservice_url}}/api/product_options
Authorization: Basic {{webservice_basic_auth}}
Content-Type: application/xml

<?xml version="1.0" encoding="UTF-8"?>
<prestashop xmlns:xlink="http://www.w3.org/1999/xlink">
  <product_option>
    <is_color_group><![CDATA[1]]></is_color_group>
    <group_type><![CDATA[color]]></group_type>
    <name>
      <language id="1"><![CDATA[couleur]]></language>
    </name>
    <public_name>
      <language id="1"><![CDATA[couleur]]></language>
    </public_name>
  </product_option>
</prestashop>
### => id_option_couleur = 6

@id_option_couleur = 6

###




# =============================================================================
# ETAPE 2 BIS - CORRECTION DES OPTIONS (si déjà créées avec un mauvais group_type)
# =============================================================================
# A exécuter UNIQUEMENT si les options ont été créées avec group_type incorrect.
# PUT remplace l'intégralité de la ressource.

#### 2B.1 - Correction group_type taille → "select"
PUT {{webservice_url}}/api/product_options/{{id_option_taille}}
Authorization: Basic {{webservice_basic_auth}}
Content-Type: application/xml

<?xml version="1.0" encoding="UTF-8"?>
<prestashop xmlns:xlink="http://www.w3.org/1999/xlink">
  <product_option>
    <id><![CDATA[{{id_option_taille}}]]></id>
    <is_color_group><![CDATA[0]]></is_color_group>
    <group_type><![CDATA[select]]></group_type>
    <name>
      <language id="1"><![CDATA[taille]]></language>
    </name>
    <public_name>
      <language id="1"><![CDATA[taille]]></language>
    </public_name>
  </product_option>
</prestashop>

###

#### 2B.2 - Correction group_type couleur → "color"
PUT {{webservice_url}}/api/product_options/{{id_option_couleur}}
Authorization: Basic {{webservice_basic_auth}}
Content-Type: application/xml

<?xml version="1.0" encoding="UTF-8"?>
<prestashop xmlns:xlink="http://www.w3.org/1999/xlink">
  <product_option>
    <id><![CDATA[{{id_option_couleur}}]]></id>
    <is_color_group><![CDATA[1]]></is_color_group>
    <group_type><![CDATA[color]]></group_type>
    <name>
      <language id="1"><![CDATA[couleur]]></language>
    </name>
    <public_name>
      <language id="1"><![CDATA[couleur]]></language>
    </public_name>
  </product_option>
</prestashop>

###




# =============================================================================
# ETAPE 3 - CREATION DES VALEURS D'OPTIONS (product_option_values)
# =============================================================================
# Une valeur = une déclinaison concrète (ex: "ngoza", "kely", "fotsy", "mainty").
# id_attribute_group = id de l'option parente (taille ou couleur).
# Le champ color (hex) est requis uniquement pour les valeurs de type couleur.

#### 3.1 - Valeur taille : ngoza (grande taille)
POST {{webservice_url}}/api/product_option_values
Authorization: Basic {{webservice_basic_auth}}
Content-Type: application/xml

<?xml version="1.0" encoding="UTF-8"?>
<prestashop xmlns:xlink="http://www.w3.org/1999/xlink">
  <product_option_value>
    <id_attribute_group><![CDATA[{{id_option_taille}}]]></id_attribute_group>
    <name>
      <language id="1"><![CDATA[ngoza]]></language>
    </name>
  </product_option_value>
</prestashop>
### => id_val_ngoza = 26

@id_val_ngoza = 26

###

#### 3.2 - Valeur taille : kely (petite taille)
POST {{webservice_url}}/api/product_option_values
Authorization: Basic {{webservice_basic_auth}}
Content-Type: application/xml

