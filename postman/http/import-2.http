# =============================================================================
# ETAPE 5 - RECUPERATION DES IDS STOCK_AVAILABLES
# =============================================================================
# PrestaShop crée automatiquement un stock_available pour chaque combination.
# On filtre par id_product + id_product_attribute pour récupérer l'id du stock.
# Pour les produits sans déclinaison : id_product_attribute = 0.

#### 5.1 - Stock T_01 / ngoza (combination 40)
GET {{webservice_url}}/api/stock_availables?filter[id_product]=[{{id_product_T01}}]&filter[id_product_attribute]=[{{id_comb_ngoza}}]&display=[id]
Authorization: Basic {{webservice_basic_auth}}
### => id_stock_ngoza = 63

@id_stock_ngoza = 63

###

#### 5.2 - Stock T_01 / kely (combination 41)
GET {{webservice_url}}/api/stock_availables?filter[id_product]=[{{id_product_T01}}]&filter[id_product_attribute]=[{{id_comb_kely}}]&display=[id]
Authorization: Basic {{webservice_basic_auth}}
### => id_stock_kely = 64

@id_stock_kely = 64

###

#### 5.3 - Stock P_01 / fotsy (combination 42)
GET {{webservice_url}}/api/stock_availables?filter[id_product]=[{{id_product_P01}}]&filter[id_product_attribute]=[{{id_comb_fotsy}}]&display=[id]
Authorization: Basic {{webservice_basic_auth}}
### => id_stock_fotsy = 65

@id_stock_fotsy = 65

###

#### 5.4 - Stock P_01 / mainty (combination 43)
GET {{webservice_url}}/api/stock_availables?filter[id_product]=[{{id_product_P01}}]&filter[id_product_attribute]=[{{id_comb_mainty}}]&display=[id]
Authorization: Basic {{webservice_basic_auth}}
### => id_stock_mainty = 66

@id_stock_mainty = 66

###

#### 5.5 - Stock C_03 (sans déclinaison → id_product_attribute = 0)
GET {{webservice_url}}/api/stock_availables?filter[id_product]=[{{id_product_C03}}]&filter[id_product_attribute]=[0]&display=[id]
Authorization: Basic {{webservice_basic_auth}}
### => id_stock_c03 = 61

@id_stock_c03 = 61

###

#### 5.6 - Stock M_02 (sans déclinaison → id_product_attribute = 0)
GET {{webservice_url}}/api/stock_availables?filter[id_product]=[{{id_product_M02}}]&filter[id_product_attribute]=[0]&display=[id]
Authorization: Basic {{webservice_basic_auth}}
### => id_stock_m02 = 62

@id_stock_m02 = 62

###




# =============================================================================
# ETAPE 6 - MISE A JOUR DES STOCKS
# =============================================================================
# quantity        = stock initial à définir.
# depends_on_stock = 0 = gestion manuelle (pas via entrepôt avancé).
# out_of_stock    = 1 = autoriser la commande même en rupture de stock
#                       (nécessaire pour que le sélecteur de déclinaison reste visible).

#### 6.1 - Stock T_01 / ngoza → 13
PATCH {{webservice_url}}/api/stock_availables/{{id_stock_ngoza}}
Authorization: Basic {{webservice_basic_auth}}
Content-Type: application/xml

<?xml version="1.0" encoding="UTF-8"?>
<prestashop xmlns:xlink="http://www.w3.org/1999/xlink">
  <stock_available>
    <id><![CDATA[{{id_stock_ngoza}}]]></id>
    <id_product><![CDATA[{{id_product_T01}}]]></id_product>
    <id_product_attribute><![CDATA[{{id_comb_ngoza}}]]></id_product_attribute>
    <quantity><![CDATA[13]]></quantity>
    <depends_on_stock><![CDATA[0]]></depends_on_stock>
    <out_of_stock><![CDATA[1]]></out_of_stock>
  </stock_available>
</prestashop>

###

