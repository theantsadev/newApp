# =============================================================================
# ETAPE 4 - CREATION DES COMBINATIONS (déclinaisons produit)
# =============================================================================
# Une combination = une variante concrète d'un produit (produit + valeur d'option).
# price = supplément HT par rapport au prix de base du produit (0.00 si prix de base).
# default_on = 1 pour la déclinaison affichée par défaut sur la fiche produit.

#### 4.1 - T_01 / ngoza - prix de base (supplément 0,00)
POST {{webservice_url}}/api/combinations
Authorization: Basic {{webservice_basic_auth}}
Content-Type: application/xml

<?xml version="1.0" encoding="UTF-8"?>
<prestashop xmlns:xlink="http://www.w3.org/1999/xlink">
  <combination>
    <id_product><![CDATA[{{id_product_T01}}]]></id_product>
    <reference><![CDATA[T_01-ngoza]]></reference>
    <price><![CDATA[0.00]]></price>
    <minimal_quantity><![CDATA[1]]></minimal_quantity>
    <default_on><![CDATA[1]]></default_on>
    <associations>
      <product_option_values>
        <product_option_value><id><![CDATA[{{id_val_ngoza}}]]></id></product_option_value>
      </product_option_values>
    </associations>
  </combination>
</prestashop>
### => id_comb_ngoza = 40

@id_comb_ngoza = 40

###

#### 4.2 - T_01 / kely - supplément +2,23 HT (→ 15,00 TTC)
